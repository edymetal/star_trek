{
  "name": "stellar-command-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Protótipo técnico de exploração e combate espacial para navegador.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "assets:check": "node tools/validate-build-assets.mjs",
    "build": "npm run typecheck && npm run assets:check && vite build && npm run offline:check",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "offline:check": "node tools/validate-offline-build.mjs",
    "postinstall": "node tools/write-install-lock-marker.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:benchmark": "npm run build && playwright test --config playwright.benchmark.config.ts",
    "test:run": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "verify": "npm run format:check && npm run lint && npm run test:run && npm run build"
  },
  "dependencies": {
    "playcanvas": "2.21.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/webxr": "0.5.24",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
